<title>Radiação Solar | Absorção, Reflexão e Transmissão</title>
<style>
:root{--navy:#073b56;--blue:#087eaa;--sky:#dff5fb;--aqua:#42c6c9;--ink:#183344;--muted:#5e7480;--cream:#fffdf7;--gold:#ffc857}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;font-family:Arial,Helvetica,sans-serif;color:var(--ink);background:#f4fbfd;line-height:1.65}
header{background:linear-gradient(135deg,#073b56,#087eaa 65%,#42c6c9);color:white;padding:22px max(6vw,22px) 76px}
nav{max-width:1100px;margin:auto;display:flex;justify-content:space-between;align-items:center;gap:20px}.brand{font-weight:800;letter-spacing:.5px}.navlinks{display:flex;gap:18px;flex-wrap:wrap}.navlinks a{color:white;text-decoration:none;font-size:.92rem;opacity:.95}.navlinks a:hover{text-decoration:underline}
.hero{max-width:1100px;margin:70px auto 0}.tag{display:inline-block;background:#ffffff24;border:1px solid #ffffff55;padding:6px 13px;border-radius:30px;font-size:.85rem}.hero h1{font-size:clamp(2.2rem,6vw,4.6rem);line-height:1.05;max-width:850px;margin:18px 0}.hero p{max-width:690px;font-size:1.12rem;color:#e6f8fc}.button{display:inline-block;margin-top:14px;background:var(--gold);color:#17394b;text-decoration:none;font-weight:800;padding:12px 20px;border-radius:12px}
main{max-width:1100px;margin:-35px auto 0;padding:0 22px 60px}.intro{background:white;border-radius:22px;padding:26px 30px;box-shadow:0 12px 35px #0b49681a}.intro strong{color:var(--blue)}
section{padding-top:55px}.section-title{font-size:2rem;color:var(--navy);margin:0 0 8px}.lead{color:var(--muted);margin-top:0}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:24px}.card{background:white;border:1px solid #dceef3;border-radius:18px;padding:22px;box-shadow:0 7px 20px #0b49680b}.icon{font-size:2rem}.card h3{color:var(--navy);margin:8px 0}.card p{margin:0;color:#47616d}.highlight{background:#e7f8fa;border-left:5px solid var(--aqua);padding:17px 20px;border-radius:10px;margin-top:20px}
.process{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:22px}.step{background:var(--navy);color:white;border-radius:16px;padding:20px}.step b{display:block;color:#9ce9eb;font-size:1.05rem;margin-bottom:6px}
.simulator{background:white;border:1px solid #dceef3;border-radius:20px;padding:24px;margin-top:22px}.controls{display:flex;gap:10px;flex-wrap:wrap;margin:15px 0}.controls button,.quiz button{border:0;border-radius:10px;padding:11px 15px;background:#e4f4f8;color:var(--navy);font-weight:700;cursor:pointer}.controls button.active,.quiz button:hover{background:var(--blue);color:white}.demo{display:grid;grid-template-columns:1fr 1fr;gap:18px;align-items:center}.surface{height:130px;border-radius:14px;display:flex;align-items:center;justify-content:center;color:white;font-weight:800;font-size:1.2rem;background:#222;transition:background .2s}.result{background:#f0f9fb;border-radius:14px;padding:18px}.result strong{color:var(--blue)}
.cover-demo{display:flex;align-items:center;gap:14px;margin-top:16px}.cover{width:100%;height:95px;border-radius:12px;background:linear-gradient(#bdebf3aa,#bdebf355),linear-gradient(180deg,#5fc4d8 0 60%,#087eaa 60%);border:3px solid #a9dce5;display:flex;align-items:center;justify-content:center;color:#073b56;font-weight:bold}
.quiz{background:#073b56;color:white;border-radius:20px;padding:25px;margin-top:22px}.quiz h3{margin-top:0}.quiz p{color:#e4f6fa}.quiz button{margin:4px 5px 4px 0}.feedback{min-height:28px;font-weight:bold;margin-top:10px}
